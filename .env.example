# ==========================================
# Rudvay-GeoMark Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# DO NOT commit your actual '.env' file to source control.
# ==========================================

# Flask Core & Security
SECRET_KEY=your_random_secure_secret_key_here
PORT=5000
USE_HTTPS=false
FORCE_LOCAL_DB=false

# Firebase Administration & Web SDK
# Option A: Place your Firebase Service Account JSON file as 'firebase_key.json' in project root
FIREBASE_CREDENTIALS=firebase_key.json
FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-app-id
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary Image Storage (Optional - fallback to Local Storage Engine if empty)
# Get credentials from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Subscriptions & Webhook Gateway (Optional - for Tenant Subscriptions)
# Get test keys from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# Platform Super Admin Initial Credentials
ADMIN_USERNAME=admin@system.local
ADMIN_PASSWORD=ChangeMeSuperAdminPassword2026!
